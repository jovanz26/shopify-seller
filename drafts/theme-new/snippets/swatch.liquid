{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch
    shape: 'square'
  %}
{% endcomment %}

{%- liquid

  assign swatch_value = null

  # Variant image alt text is usually the product title, not a color: fall back
  # to the option value name (White, Black, Orange…), which is a CSS color keyword.
  if swatch_type == "image_alt"
    assign alt_start = custom_color_swatch | slice: 0
    unless alt_start == "#" or custom_color_swatch contains "rgb"
      assign value_name = value.name | default: value
      assign custom_color_swatch = value_name | split: " " | first | downcase
    endunless
  endif

  if swatch.image
    assign image_url = swatch.image | image_url: width: 50
    assign swatch_value = 'url(' | append: image_url | append: ')'
    assign swatch_focal_point = swatch.image.presentation.focal_point
  elsif swatch.color
    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  endif
-%}

<span
    class="swatch{% if shape == 'square' %} swatch--square{% endif %} color-swatch"
    style="{% if swatch_type == 'custom_color' or swatch_type == 'image_alt' %}background: {{ custom_color_swatch }};{% elsif swatch_type == 'image' %} background-image: url({{ custom_color_swatch }});{% endif %}"

>
<span class="color-swatch__label">{{value}}</span>

</span>
